{
	"name": "n8n-nodes-looot",
	"version": "0.1.0",
	"description": "n8n community node for looot: search, inspect and run 2,500+ data endpoints (email finding, company enrichment, SERP, news) with one prepaid balance.",
	"license": "MIT",
	"homepage": "https://docs.looot.ai/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"looot",
		"data enrichment",
		"email finder",
		"serp"
	],
	"author": {
		"name": "looot",
		"email": "support@looot.ai",
		"url": "https://looot.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/loootai/n8n-nodes-looot.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LoootApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Looot/Looot.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.51.1",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3",
		"n8n-workflow": "2.16.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
